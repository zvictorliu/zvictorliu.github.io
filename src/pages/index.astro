---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { homeByLocale, contactEmail } from '../data/home';
import { loadHomeCollections } from '../data/collections';

const locale = 'zh' as const;
const { profile, path } = homeByLocale[locale];
const { recentPosts, recentProjects, recentPublications } = await loadHomeCollections();
---

<Layout locale={locale} title="刘宗炜">
  <HomePage
    locale={locale}
    profile={profile}
    path={path}
    recentPosts={recentPosts}
    recentProjects={recentProjects}
    recentPublications={recentPublications}
    contactEmail={contactEmail}
  />
</Layout>
