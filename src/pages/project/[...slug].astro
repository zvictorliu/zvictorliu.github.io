---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const locale = (Astro.currentLocale || 'zh') as Locale;
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const presentLabel = locale === 'zh' ? '至今' : 'Present';
const { project } = Astro.props;
const { Content } = await render(project);
const startDate = project.data.startDate ?? project.data.date;
const endDate = project.data.endDate ?? project.data.date;
const dateText = startDate
  ? `${startDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long' })} – ${
      project.data.ongoing
        ? presentLabel
        : endDate
          ? endDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long' })
          : presentLabel
    }`
  : endDate
    ? endDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long' })
    : '';

const title = locale === 'en' && project.data.titleEn ? project.data.titleEn : project.data.title;
const summary = locale === 'en' && project.data.summaryEn ? project.data.summaryEn : project.data.summary;
const award = locale === 'en' && project.data.awardEn ? project.data.awardEn : project.data.award;
---

<Layout title={`${title} - Zongwei Liu`} locale={locale}>
  <article class="article-page">
    <header class="article-header">
      <h1>{title}</h1>
      {dateText && <p class="entry-meta">{dateText}</p>}
      {project.data.tags && project.data.tags.length > 0 && (
        <div class="tag-row">
          {project.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      {summary && <p class="entry-excerpt">{summary}</p>}
      {award && <p class="entry-meta">{award}</p>}
      <div class="entry-links">
        {project.data.repo && (
          <a href={project.data.repo} target="_blank" rel="noopener">Repo</a>
        )}
        {project.data.demo && (
          <a href={project.data.demo} target="_blank" rel="noopener">Demo</a>
        )}
      </div>
    </header>
    <section class="article-content">
      <Content />
    </section>
  </article>
</Layout>
