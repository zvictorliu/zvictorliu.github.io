---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n';

const locale = (Astro.currentLocale || 'zh') as Locale;
const t = useTranslations(locale);
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';

const posts = (await getCollection('post', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={`${t.posts.title} - ${t.brand}`} locale={locale}>
  <section class="page-block">
    <div class="container">
      <header class="page-header">
        <h1>{t.posts.title}</h1>
        <p class="page-subtitle">{locale === 'zh' ? '写过、且愿意公开的' : 'Notes I am willing to keep'}</p>
      </header>

      {posts.map((post) => (
        <article class="entry">
          <p class="entry-meta">
            {post.data.date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}
          </p>
          <h2 class="entry-title">
            <a href={getRelativeLocaleUrl(locale, `/post/${post.id.replace(/\.md$/, '')}`)}>{post.data.title}</a>
          </h2>
          {post.data.description && <p class="entry-excerpt">{post.data.description}</p>}
        </article>
      ))}

      {posts.length === 0 && (
        <p class="empty-state">{locale === 'zh' ? '还没有文章。' : 'No posts yet.'}</p>
      )}
    </div>
  </section>
</Layout>
