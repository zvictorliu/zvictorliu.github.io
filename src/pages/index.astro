---
import Layout from '../layouts/Layout.astro';

const allPosts = Object.values(import.meta.glob('./post/*.md', { eager: true }));
const recentPosts = allPosts
  .filter((post: any) => !post.frontmatter.draft)
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf())
  .slice(0, 3);

const profile = {
  name: 'Zongwei Liu',
  title: 'A postgraduate',
  institution: 'Shanghai Jiao Tong University',
  institutionUrl: 'https://www.sjtu.edu.cn/',
  bio: "Welcome! I am Zongwei Liu (刘宗炜), a graduate student at SJTU, majoring in Electronic Information. I am pursuing a master degree in Shanghai Jiao Tong University. Hope I can graduate smoothly and have a beautiful life in the future.",
  avatar: '/images/avatar.jpg',
  interests: ['Computer Systems', 'Artificial Intelligence', 'History'],
  education: [
    { course: 'MSc in Electronic Information', institution: 'Shanghai Jiao Tong University', year: 'present' },
    { course: 'BSc in Measurement And Instrumentation', institution: 'Shanghai Jiao Tong University', year: '2024' },
  ],
  skills: [
    { name: 'Python', percent: 70, icon: 'fab fa-python', category: 'Technical' },
    { name: 'C/C++', percent: 80, icon: 'fab fa-c', category: 'Technical' },
    { name: 'Linux', percent: 60, icon: 'fab fa-linux', category: 'Technical' },
    { name: 'Movies & TV Series', percent: 100, icon: 'fas fa-film', category: 'Hobbies' },
    { name: 'History', percent: 90, icon: 'fas fa-book', category: 'Hobbies' },
    { name: 'Music', percent: 70, icon: 'fas fa-music', category: 'Hobbies' },
  ],
  experience: [
    {
      title: 'MSc in Electronic Information',
      company: 'Shanghai Jiao Tong University',
      companyUrl: 'https://www.sjtu.edu.cn/',
      location: 'Shanghai, China',
      dateStart: 'September 2024',
      dateEnd: 'Present',
      description: 'Pursuing a MSc degree',
    },
    {
      title: 'BSc in Measurement And Instrumentation',
      company: 'Shanghai Jiao Tong University',
      companyUrl: 'https://www.sjtu.edu.cn/',
      location: 'Shanghai, China',
      dateStart: 'September 2020',
      dateEnd: 'June 2024',
      description: 'Received a BSc degree',
    },
  ],
  work: [
    {
      title: 'Research Intern',
      company: 'CHC Navigation',
      companyUrl: 'https://www.chcnav.com/',
      logo: '/media/icons/brands/huace.jpg',
      location: 'Shanghai, China',
      dateStart: 'June 2025',
      dateEnd: 'Present',
      description: 'Conducted research on GNSS signal processing and NLOS mitigation algorithms.',
    },
    {
      title: 'Development Intern',
      company: 'Softbank Robotics',
      companyUrl: 'https://www.softbankrobotics.com.cn/',
      logo: '/media/icons/brands/softbank-robotics.png',
      location: 'Shanghai, China',
      dateStart: 'June 2023',
      dateEnd: 'August 2023',
      description: 'Developed application software of the Pepper robot.',
    },
  ],
  social: [
    { icon: 'fas fa-envelope', link: 'mailto:zvictorliu@outlook.com', label: 'Email' },
    { icon: 'fab fa-github', link: 'https://github.com/zvictorliu', label: 'GitHub' },
    // { icon: 'ai ai-cv', link: '/uploads/resume.pdf', label: 'CV' },
    { icon: 'fas fa-microchip', link: 'https://zvictorliu.github.io/techBlog/', label: 'Tech Blog' },
  ],
  publications: [
    {
      title: 'Performance of GNSS SPP/PPP/RTK with mitigation on NLOS signals in proximity to building edges',
      authors: ['Zongwei Liu', 'Yan Xiang', 'Mingxiang Gu', 'Yifan Zhao', 'Ruiyang Zhou', 'Ling Pei'],
      year: '2025',
      journal: 'Advances in Space Research',
      doi: 'https://doi.org/10.1016/j.asr.2025.09.038',
      url: '/publication/liu-2025/',
      highlightedAuthor: 'Zongwei Liu',
    },
    {
      title: 'SVA: A Street-View-Aided GNSS Positioning Framework With 2DSDM and Likelihood Road for NLOS/Multipath Mitigation',
      authors: ['Mingxiang Gu', 'Tao Li', 'Guoqing Liu', 'Zongwei Liu', 'Chaoran Xiong', 'Chao Wang', 'Rui Duan', 'Fanchen Meng', 'Yan Xiang', 'Ling Pei'],
      year: '2025',
      journal: 'IEEE ROBOTICS AND AUTOMATION LETTERS',
      doi: 'https://doi.org/10.1109/LRA.2025.3583628',
      url: '/publication/gu-2025/',
      highlightedAuthor: 'Zongwei Liu',
    },
  ],
};

const contact = {
  email: 'zvictorliu@outlook.com',
  address: '800 Dongchuan Road, Shanghai, China',
};
---

<Layout>
  <section id="about" class="section about-section">
    <div class="container">
      <div class="about-grid">
        <div class="profile-card">
          <div class="avatar-wrapper">
            <img 
              src={profile.avatar} 
              alt={profile.name}
              class="avatar"
              onerror="this.src='https://www.gravatar.com/avatar/?d=mp&s=270'"
            />
          </div>
          <h2 class="profile-name">{profile.name}</h2>
          <h3 class="profile-title">{profile.title}</h3>
          <h3 class="profile-institution">
            <a href={profile.institutionUrl} target="_blank" rel="noopener">
              {profile.institution}
            </a>
          </h3>
          <div class="social-links">
            {profile.social.map((item) => (
              <a href={item.link} target="_blank" rel="noopener" aria-label={item.label}>
                <i class={item.icon}></i>
              </a>
            ))}
          </div>
        </div>

        <div class="bio-content">
          <h2 class="section-title">Biography</h2>
          <p class="bio-text">{profile.bio}</p>

          <div class="info-grid">
            <div class="info-section">
              <h3 class="info-title">Interests</h3>
              <ul class="interests-list">
                {profile.interests.map((interest) => (
                  <li>
                    <i class="fas fa-book-open"></i>
                    {interest}
                  </li>
                ))}
              </ul>
            </div>

            <div class="info-section">
              <h3 class="info-title">Education</h3>
              <ul class="education-list">
                {profile.education.map((edu) => (
                  <li>
                    <i class="fas fa-graduation-cap"></i>
                    <div class="edu-details">
                      <p class="course">{edu.course}, {edu.year}</p>
                      <p class="institution">{edu.institution}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="section skills-section">
    <div class="container">
      <h2 class="section-title">Skills</h2>
      <div class="skills-grid">
        {['Technical', 'Hobbies'].map((category) => (
          <div class="skill-category">
            <h3 class="skill-category-title">{category}</h3>
            {profile.skills
              .filter((skill) => skill.category === category)
              .map((skill) => (
                <div class="skill-item">
                  <div class="skill-header">
                    <i class={skill.icon}></i>
                    <span class="skill-name">{skill.name}</span>
                  </div>
                  <div class="skill-bar">
                    <div class="skill-progress" style={`width: ${skill.percent}%`}></div>
                  </div>
                </div>
              ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="education" class="section education-section">
    <div class="container">
      <h2 class="section-title">Education</h2>
      <div class="experience-timeline">
        {profile.experience.map((exp, index) => (
          <div class="experience-item">
            <div class="timeline-marker">
              <span class={`marker-dot ${index === 0 ? 'current' : ''}`}></span>
              {index < profile.experience.length - 1 && <div class="timeline-line"></div>}
            </div>
            <div class="experience-card">
              <div class="card-header">
                <div class="company-logo">
                  <a href={exp.companyUrl} target="_blank" rel="noopener">
                    <img src="/media/icons/brands/sjtulogo.svg" alt={exp.company} width="56" height="56" />
                  </a>
                </div>
                <div class="card-title-group">
                  <h3 class="card-title">{exp.title}</h3>
                  <p class="card-company">
                    <a href={exp.companyUrl} target="_blank" rel="noopener">{exp.company}</a>
                  </p>
                  <p class="card-meta">
                    {exp.dateStart} – {exp.dateEnd}
                    <span class="divider"></span>
                    {exp.location}
                  </p>
                </div>
              </div>
              <p class="card-description">{exp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="experience" class="section experience-section">
    <div class="container">
      <h2 class="section-title">Experience</h2>
      <div class="experience-timeline">
        {profile.work.map((exp, index) => (
          <div class="experience-item">
            <div class="timeline-marker">
              <span class={`marker-dot ${index === 0 ? 'current' : ''}`}></span>
              {index < profile.work.length - 1 && <div class="timeline-line"></div>}
            </div>
            <div class="experience-card">
              <div class="card-header">
                <div class="company-logo">
                  <a href={exp.companyUrl} target="_blank" rel="noopener">
                    <img src={exp.logo} alt={exp.company} width="56" height="56" />
                  </a>
                </div>
                <div class="card-title-group">
                  <h3 class="card-title">{exp.title}</h3>
                  <p class="card-company">
                    <a href={exp.companyUrl} target="_blank" rel="noopener">{exp.company}</a>
                  </p>
                  <p class="card-meta">
                    {exp.dateStart} – {exp.dateEnd}
                    <span class="divider"></span>
                    {exp.location}
                  </p>
                </div>
              </div>
              <p class="card-description">{exp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="posts" class="section posts-section">
    <div class="container">
      <h2 class="section-title">Recent Posts</h2>
      <div class="posts-list">
        {recentPosts.map((post: any) => (
          <article class="post-item">
            <div class="post-content">
              <h3 class="post-title">
                <a href={post.url}>{post.frontmatter.title}</a>
              </h3>
              <div class="post-meta">
                <span class="post-date">{new Date(post.frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                <span class="divider"></span>
                <span class="post-read-time">1 min read</span>
              </div>
              <p class="post-excerpt">{post.frontmatter.description}</p>
            </div>
            {post.frontmatter.image && (
              <div class="post-image">
                <a href={post.url}>
                  <img src={post.frontmatter.image} alt={post.frontmatter.title} loading="lazy" />
                </a>
              </div>
            )}
          </article>
        ))}
        <div class="see-all">
          <a href="/post/">
            See all posts
            <i class="fas fa-angle-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="publications" class="section publications-section">
    <div class="container">
      <h2 class="section-title">Recent Publications</h2>
      <div class="publications-list">
        {profile.publications.map((pub) => (
          <div class="publication-item">
            <i class="far fa-file-alt pub-icon"></i>
            <div class="pub-content">
              <p class="pub-authors">
                {pub.authors.map((author, i) => (
                  <span class={author === pub.highlightedAuthor ? 'highlighted' : ''}>
                    {author}{i < pub.authors.length - 1 ? ', ' : ''}
                  </span>
                ))}
                ({pub.year}).
              </p>
              <h3 class="pub-title">
                <a href={pub.url}>{pub.title}</a>
              </h3>
              <p class="pub-journal">
                <em>{pub.journal}</em>
              </p>
              <div class="pub-links">
                <a href={pub.doi} target="_blank" rel="noopener" class="btn btn-sm">DOI</a>
                <a href={pub.url} class="btn btn-sm">URL</a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="see-all">
        <a href="/publication/">
          See all publications
          <i class="fas fa-angle-right"></i>
        </a>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="container">
      <h2 class="section-title">Contact</h2>
      <div class="contact-grid">
        <div class="contact-info">
          <h3>Get in Touch</h3>
          <p class="contact-text">
            If you like, you can leave a message here and I will reply as soon as possible.
          </p>
          <ul class="contact-list">
            <li>
              <i class="fas fa-envelope"></i>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
            <li>
              <i class="fas fa-map-marker-alt"></i>
              <span>{contact.address}</span>
            </li>
          </ul>
        </div>
        <div class="contact-form-wrapper">
          <form class="contact-form" action="#" method="POST">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Send</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    align-items: start;
  }

  .profile-card {
    text-align: center;
    background: var(--card-bg);
    padding: 2rem;
    border-radius: 8px;
  }

  .avatar-wrapper {
    margin-bottom: 1.5rem;
  }

  .avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--border-color);
  }

  .profile-name {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .profile-title {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .profile-institution {
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .profile-institution a {
    color: var(--accent-color);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-color);
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .social-links a:hover {
    background: var(--accent-color);
    color: white;
    transform: translateY(-2px);
  }

  .bio-content .section-title {
    text-align: left;
    margin-bottom: 1.5rem;
  }

  .bio-text {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    text-align: justify;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .info-title {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--text-secondary);
  }

  .interests-list,
  .education-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .interests-list li,
  .education-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .interests-list i {
    color: var(--accent-color);
    margin-top: 0.25rem;
  }

  .education-list i {
    color: var(--accent-color);
    margin-top: 0.25rem;
  }

  .edu-details .course {
    margin: 0;
    font-weight: 500;
  }

  .edu-details .institution {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
  }

  .skill-category-title {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .skill-item {
    margin-bottom: 1.25rem;
  }

  .skill-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .skill-header i {
    width: 20px;
    color: var(--accent-color);
  }

  .skill-name {
    font-weight: 500;
  }

  .skill-bar {
    height: 6px;
    background: var(--border-color);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-progress {
    height: 100%;
    background: var(--accent-color);
    border-radius: 3px;
    transition: width 0.5s ease;
  }

  .experience-timeline {
    max-width: 800px;
    margin: 0 auto;
  }

  .experience-item {
    display: flex;
    gap: 1.5rem;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.5rem;
  }

  .marker-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--accent-color);
    background: var(--bg-color);
  }

  .marker-dot.current {
    background: var(--accent-color);
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    background: var(--border-color);
    margin-top: 0.5rem;
  }

  .experience-card {
    flex: 1;
    background: var(--card-bg);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .card-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .company-logo img {
    border-radius: 8px;
  }

  .card-title {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
  }

  .card-company {
    margin: 0 0 0.25rem 0;
    color: var(--text-secondary);
  }

  .card-meta {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .divider {
    margin: 0 0.5rem;
    color: var(--border-color);
  }

  .card-description {
    margin: 0;
    color: var(--text-secondary);
  }

  .posts-list,
  .publications-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .post-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .post-content {
    flex: 1;
  }

  .post-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
  }

  .post-meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .post-excerpt {
    margin: 0;
    color: var(--text-secondary);
  }

  .post-image {
    width: 150px;
    flex-shrink: 0;
  }

  .post-image img {
    width: 100%;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
  }

  .publication-item {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .pub-icon {
    font-size: 1.5rem;
    color: var(--accent-color);
    flex-shrink: 0;
  }

  .pub-authors {
    margin: 0 0 0.5rem 0;
    font-size: 0.95rem;
  }

  .pub-authors .highlighted {
    background: rgba(37, 99, 235, 0.15);
    padding: 0 2px;
    border-radius: 2px;
  }

  .pub-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
  }

  .pub-journal {
    margin: 0 0 1rem 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .pub-links {
    display: flex;
    gap: 0.5rem;
  }

  .see-all {
    text-align: center;
    margin-top: 2rem;
  }

  .see-all a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-info h3 {
    margin-bottom: 1rem;
  }

  .contact-text {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact-list i {
    width: 24px;
    color: var(--accent-color);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 500;
    font-size: 0.9rem;
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    background: var(--bg-color);
    color: var(--text-color);
    font-family: inherit;
    font-size: 1rem;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-color);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--accent-color);
    border-radius: 4px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    background: transparent;
    color: var(--accent-color);
  }

  .btn:hover {
    background: var(--accent-color);
    color: white;
  }

  .btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.85rem;
  }

  .btn-primary {
    background: var(--accent-color);
    color: white;
  }

  .btn-primary:hover {
    background: var(--text-color);
    border-color: var(--text-color);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .profile-card {
      max-width: 350px;
      margin: 0 auto;
    }

