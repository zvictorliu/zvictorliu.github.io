---
interface Props {
  hint: string;
  skip: string;
}

const { hint, skip } = Astro.props;
---

<div class="room-stage">
  <canvas id="room-canvas"></canvas>
  <p class="room-hint is-intro" data-hint={hint} data-skip={skip}>{skip}</p>
</div>

<script>
  import { initRoom } from '../lib/room';

  const canvas = document.getElementById('room-canvas');
  const hintEl = document.querySelector('.room-hint');
  if (canvas instanceof HTMLCanvasElement) {
    const dispose = initRoom(canvas, {
      hintEl: hintEl instanceof HTMLElement ? hintEl : undefined,
    });
    window.addEventListener('pagehide', dispose, { once: true });
  }
</script>

<style>
  .room-stage {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--header-height));
    overflow: hidden;
    background: #000;
  }

  #room-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .room-hint {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    margin: 0;
    transform: translateX(-50%);
    color: rgba(236, 232, 225, 0.72);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    pointer-events: none;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
    white-space: nowrap;
    transition: opacity 0.55s ease, letter-spacing 0.55s ease;
  }

  .room-hint.is-intro {
    color: rgba(236, 232, 225, 0.4);
    letter-spacing: 0.18em;
  }
</style>
