---
import Layout from './Layout.astro';

interface Props {
  title?: string;
  locale?: string;
}

const { title, locale = 'zh' } = Astro.props;
---

<Layout title={title} locale={locale}>
  <article class="article-page markdown-page">
    <div class="article-content">
      <slot />
    </div>
  </article>
</Layout>
