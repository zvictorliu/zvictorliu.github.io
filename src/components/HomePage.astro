---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n';
import type { HomeProfile, PathItem } from '../data/home';

interface Props {
  locale: Locale;
  profile: HomeProfile;
  path: PathItem[];
  recentPosts: CollectionEntry<'post'>[];
  recentProjects: CollectionEntry<'projects'>[];
  recentPublications: CollectionEntry<'publication'>[];
  contactEmail: string;
}

const {
  locale,
  profile,
  path,
  recentPosts,
  recentProjects,
  recentPublications,
  contactEmail,
} = Astro.props;

const t = useTranslations(locale);
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const presentLabel = locale === 'zh' ? '至今' : 'Present';
const dateTbd = locale === 'zh' ? '日期待定' : 'Date TBD';

const formatProjectDate = (project: CollectionEntry<'projects'>) => {
  const start = project.data.startDate ?? project.data.date;
  const end = project.data.endDate ?? project.data.date;
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short' };
  if (start && project.data.ongoing) {
    return `${start.toLocaleDateString(dateLocale, options)} – ${presentLabel}`;
  }
  if (start && end) {
    return `${start.toLocaleDateString(dateLocale, options)} – ${end.toLocaleDateString(dateLocale, options)}`;
  }
  if (start) return start.toLocaleDateString(dateLocale, options);
  if (end) return end.toLocaleDateString(dateLocale, options);
  return dateTbd;
};

const projectListUrl = getRelativeLocaleUrl(locale, '/project');
const publicationListUrl = getRelativeLocaleUrl(locale, '/publication');
const postListUrl = getRelativeLocaleUrl(locale, '/post');
const projectUrl = (id: string) => getRelativeLocaleUrl(locale, `/project/${id.replace(/\.md$/, '')}`);
const publicationUrl = (id: string) => getRelativeLocaleUrl(locale, `/publication/${id.replace(/\.md$/, '')}`);
const postUrl = (id: string) => getRelativeLocaleUrl(locale, `/post/${id.replace(/\.md$/, '')}`);

const featuredProject = recentProjects.find((project) => project.data.featured);
const otherProjects = recentProjects
  .filter((project) => project.id !== featuredProject?.id)
  .slice(0, 2);

const projectTitle = (project: CollectionEntry<'projects'>) =>
  locale === 'en' && project.data.titleEn ? project.data.titleEn : project.data.title;

const projectSummary = (project: CollectionEntry<'projects'>) =>
  locale === 'en' && project.data.summaryEn ? project.data.summaryEn : project.data.summary;

const projectAward = (project: CollectionEntry<'projects'>) =>
  locale === 'en' && project.data.awardEn ? project.data.awardEn : project.data.award;
---

<section id="about" class="section hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">
        <a href={profile.institutionUrl} target="_blank" rel="noopener">{profile.institution}</a>
        <span class="meta-sep">·</span>
        {profile.role}
      </p>
      <h1 class="hero-name">{profile.name}</h1>
      {profile.bio.split('\n').filter(Boolean).map((paragraph) => (
        <p class="bio-text">{paragraph.trim()}</p>
      ))}
      <ul class="interests-list">
        {profile.interests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
      <div class="social-links">
        {profile.social.map((item) => (
          <a href={item.href} target={item.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
            {item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="hero-photo">
      <img src={profile.avatar} alt={profile.name} class="avatar" />
    </div>
  </div>
</section>

{recentProjects.length > 0 && (
  <section id="work" class="section">
    <div class="container">
      <h2 class="section-title">{t.work.title}</h2>
      {featuredProject && (
        <article class="featured">
          <div class="featured-copy">
            <p class="featured-kicker">{t.work.featured}</p>
            <h3 class="featured-title">
              <a href={projectUrl(featuredProject.id)}>{projectTitle(featuredProject)}</a>
            </h3>
            <p class="entry-meta">{formatProjectDate(featuredProject)}</p>
            {projectSummary(featuredProject) && (
              <p class="featured-summary">{projectSummary(featuredProject)}</p>
            )}
            {projectAward(featuredProject) && (
              <p class="featured-award">{projectAward(featuredProject)}</p>
            )}
            <div class="entry-links">
              <a href={projectUrl(featuredProject.id)}>{t.work.details}</a>
              {featuredProject.data.repo && (
                <a href={featuredProject.data.repo} target="_blank" rel="noopener">Repo</a>
              )}
              {featuredProject.data.demo && (
                <a href={featuredProject.data.demo} target="_blank" rel="noopener">Demo</a>
              )}
            </div>
          </div>
          {featuredProject.data.image && (
            <a class="featured-image" href={projectUrl(featuredProject.id)}>
              <img src={featuredProject.data.image} alt={projectTitle(featuredProject)} />
            </a>
          )}
        </article>
      )}
      {otherProjects.length > 0 && (
        <div class="entry-list">
          {otherProjects.map((project) => (
            <article class="entry">
              <h3 class="entry-title">
                <a href={projectUrl(project.id)}>{projectTitle(project)}</a>
              </h3>
              <p class="entry-meta">{formatProjectDate(project)}</p>
              {projectSummary(project) && <p class="entry-excerpt">{projectSummary(project)}</p>}
              <div class="entry-links">
                <a href={projectUrl(project.id)}>{t.work.details}</a>
                {project.data.repo && (
                  <a href={project.data.repo} target="_blank" rel="noopener">Repo</a>
                )}
                {project.data.demo && (
                  <a href={project.data.demo} target="_blank" rel="noopener">Demo</a>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
      <p class="see-all">
        <a href={projectListUrl}>{t.work.seeAll}</a>
      </p>
    </div>
  </section>
)}

<section id="path" class="section">
  <div class="container">
    <h2 class="section-title">{t.path.title}</h2>
    <div class="experience-timeline">
      {path.map((item, index) => (
        <div class="experience-item">
          <div class="timeline-marker">
            <span class:list={['marker-dot', item.current && 'current']}></span>
            {index < path.length - 1 && <div class="timeline-line"></div>}
          </div>
          <div class="experience-card">
            <div class="card-header">
              <div class="company-logo">
                <a href={item.orgUrl} target="_blank" rel="noopener">
                  <img src={item.logo} alt={item.org} width="56" height="56" />
                </a>
              </div>
              <div class="card-title-group">
                <h3 class="card-title">{item.title}</h3>
                <p class="card-company">
                  <a href={item.orgUrl} target="_blank" rel="noopener">{item.org}</a>
                </p>
                <p class="card-meta">
                  {item.dateLabel}
                  <span class="meta-sep">·</span>
                  {item.location}
                </p>
              </div>
            </div>
            {item.description && <p class="card-description">{item.description}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

{recentPublications.length > 0 && (
  <section id="publications" class="section">
    <div class="container">
      <h2 class="section-title">{t.publications.title}</h2>
      <div class="entry-list">
        {recentPublications.map((pub) => (
          <article class="entry">
            <p class="pub-authors">
              {pub.data.authors.map((author, i) => (
                <span class={author === pub.data.highlightedAuthor ? 'highlighted' : ''}>
                  {author}{i < pub.data.authors.length - 1 ? ', ' : ''}
                </span>
              ))}
              ({pub.data.date.getFullYear()}).
            </p>
            <h3 class="entry-title">
              <a href={publicationUrl(pub.id)}>{pub.data.title}</a>
            </h3>
            <p class="entry-excerpt">
              <em>{pub.data.journal}</em>
            </p>
            <div class="entry-links">
              <a href={pub.data.doi} target="_blank" rel="noopener">DOI</a>
            </div>
          </article>
        ))}
      </div>
      <p class="see-all">
        <a href={publicationListUrl}>{t.publications.seeAll}</a>
      </p>
    </div>
  </section>
)}

{recentPosts.length > 0 && (
  <section id="posts" class="section">
    <div class="container">
      <h2 class="section-title">{t.posts.title}</h2>
      <div class="entry-list">
        {recentPosts.map((post) => (
          <article class="entry">
            <h3 class="entry-title">
              <a href={postUrl(post.id)}>{post.data.title}</a>
            </h3>
            <p class="entry-meta">
              {post.data.date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}
            </p>
            {post.data.description && <p class="entry-excerpt">{post.data.description}</p>}
          </article>
        ))}
      </div>
      <p class="see-all">
        <a href={postListUrl}>{t.posts.seeAll}</a>
      </p>
    </div>
  </section>
)}

<section id="contact" class="section">
  <div class="container contact-block">
    <h2 class="section-title">{t.contact.title}</h2>
    <p class="contact-text">{t.contact.message}</p>
    <p class="contact-email">
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
  </div>
</section>

<style>
  .hero {
    padding-top: 4.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 168px;
    gap: 3rem;
    align-items: start;
  }

  .hero-kicker {
    margin: 0 0 0.55rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .hero-name {
    font-size: 2.7rem;
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .avatar {
    width: 168px;
    height: 210px;
    border-radius: 2px;
    object-fit: cover;
  }

  .bio-text {
    font-size: 1.05rem;
    line-height: 1.85;
    margin: 0 0 1rem;
  }

  .interests-list {
    list-style: none;
    padding: 0;
    margin: 0.15rem 0 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .interests-list li {
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.15rem;
  }

  .social-links a {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .featured {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: start;
    padding-bottom: 1.75rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .featured-kicker {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--accent-color);
    margin: 0 0 0.55rem;
  }

  .featured-title {
    font-size: 1.4rem;
    line-height: 1.4;
    margin: 0 0 0.45rem;
  }

  .featured-summary {
    margin: 0 0 0.75rem;
    line-height: 1.75;
  }

  .featured-award {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .featured-image:hover {
    text-decoration: none;
  }

  .featured-image img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: top left;
    border-radius: 2px;
    border: 1px solid var(--border-color);
  }

  .entry {
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .entry-title {
    margin: 0 0 0.35rem;
    font-size: 1.12rem;
  }

  .entry-meta {
    margin: 0 0 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .entry-excerpt {
    margin: 0 0 0.65rem;
    color: var(--text-secondary);
  }

  .entry-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }

  .entry-links a {
    color: var(--text-secondary);
  }

  .pub-authors {
    margin: 0 0 0.35rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  .pub-authors .highlighted {
    color: var(--text-color);
    font-weight: 600;
  }

  .see-all {
    margin: 1.25rem 0 0;
  }

  .see-all a {
    color: var(--text-secondary);
  }

  .experience-item {
    display: flex;
    gap: 1.25rem;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.45rem;
  }

  .marker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--accent-color);
    background: var(--bg-color);
  }

  .marker-dot.current {
    background: var(--accent-color);
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    background: var(--border-color);
    margin-top: 0.5rem;
  }

  .experience-card {
    flex: 1;
    padding: 0 0 1.75rem;
  }

  .card-header {
    display: flex;
    gap: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .company-logo img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .card-title {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
  }

  .card-company {
    margin: 0 0 0.2rem;
    color: var(--text-secondary);
  }

  .card-meta {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .meta-sep {
    margin: 0 0.4rem;
  }

  .card-description {
    margin: 0;
    color: var(--text-secondary);
  }

  .contact-text {
    color: var(--text-secondary);
    margin: 0 0 0.6rem;
  }

  .contact-email {
    margin: 0;
    font-size: 1.1rem;
    font-family: var(--font-display);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 2.75rem;
    }

    .hero-grid,
    .featured {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hero-name {
      font-size: 2.1rem;
    }

    .hero-photo {
      order: -1;
    }

    .avatar {
      width: 112px;
      height: 140px;
    }

    .featured-image img {
      height: 180px;
    }
  }
</style>
