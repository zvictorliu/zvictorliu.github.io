---
import type { ResumeItem } from '../data/home';

interface Props {
  items: ResumeItem[];
}

const { items } = Astro.props;
---

<div class="experience-timeline">
  {items.map((item, index) => (
    <div class="experience-item">
      <div class="timeline-marker">
        <span class:list={['marker-dot', item.current && 'current']}></span>
        {index < items.length - 1 && <div class="timeline-line"></div>}
      </div>
      <div class="experience-card">
        <div class="card-header">
          <div class="company-logo">
            <a href={item.orgUrl} target="_blank" rel="noopener">
              <img src={item.logo} alt={item.org} width="56" height="56" />
            </a>
          </div>
          <div class="card-title-group">
            <h3 class="card-title">{item.title}</h3>
            <p class="card-company">
              <a href={item.orgUrl} target="_blank" rel="noopener">{item.org}</a>
            </p>
            <p class="card-meta">
              {item.dateLabel}
              <span class="meta-sep">·</span>
              {item.location}
            </p>
          </div>
        </div>
        {item.description && <p class="card-description">{item.description}</p>}
      </div>
    </div>
  ))}
</div>

<style>
  .experience-item {
    display: flex;
    gap: 1.25rem;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.45rem;
  }

  .marker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--accent-color);
    background: var(--bg-color);
  }

  .marker-dot.current {
    background: var(--accent-color);
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    background: var(--border-color);
    margin-top: 0.5rem;
  }

  .experience-card {
    flex: 1;
    padding: 0 0 1.75rem;
  }

  .card-header {
    display: flex;
    gap: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .company-logo img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .card-title {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
  }

  .card-company {
    margin: 0 0 0.2rem;
    color: var(--text-secondary);
  }

  .card-meta {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .card-description {
    margin: 0;
    color: var(--text-secondary);
  }
</style>
