---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('post', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Posts - Zongwei Liu">
  <section class="posts-page">
    <div class="container">
      <header class="page-header">
        <h1>Posts</h1>
        <p class="page-subtitle">Technical articles, tutorials, and more</p>
      </header>

      <div class="posts-grid">
        {posts.map((post) => (
          <article class="post-card">
            {post.data.image && (
              <a href={`/post/${post.id.replace(/\.md$/, '')}`} class="post-image-link">
                <img src={post.data.image} alt={post.data.title} loading="lazy" />
              </a>
            )}
            <div class="post-content">
              <h2 class="post-title">
                <a href={`/post/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
              </h2>
              <div class="post-meta">
                <span class="post-date">
                  <i class="fas fa-calendar"></i>
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
                <span class="post-author">
                  <i class="fas fa-user"></i>
                  {post.data.author || 'Zongwei Liu'}
                </span>
              </div>
              <p class="post-description">{post.data.description}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              <a href={`/post/${post.id.replace(/\.md$/, '')}`} class="read-more">
                Read more <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="empty-state">
          <i class="fas fa-inbox"></i>
          <p>No posts yet. Stay tuned!</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .posts-page {
    padding: 3rem 0 5rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .posts-grid {
    display: grid;
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .post-card {
    display: flex;
    gap: 1.5rem;
    background: var(--card-bg);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .post-image-link {
    flex-shrink: 0;
    width: 280px;
  }

  .post-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .post-title {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .post-title a {
    color: var(--text-color);
  }

  .post-title a:hover {
    color: var(--accent-color);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .post-meta span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .post-meta i {
    color: var(--accent-color);
    font-size: 0.85rem;
  }

  .post-description {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.6;
    flex: 1;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    padding: 0.2rem 0.6rem;
    background: var(--bg-color);
    color: var(--text-secondary);
    border-radius: 16px;
    font-size: 0.8rem;
    border: 1px solid var(--border-color);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-color);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .read-more:hover {
    gap: 0.75rem;
  }

  .read-more i {
    transition: transform 0.2s;
  }

  .read-more:hover i {
    transform: translateX(4px);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-secondary);
  }

  .empty-state i {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .post-card {
      flex-direction: column;
    }

    .post-image-link {
      width: 100%;
      height: 200px;
    }

    .page-header h1 {
      font-size: 2rem;
    }
  }
</style>
