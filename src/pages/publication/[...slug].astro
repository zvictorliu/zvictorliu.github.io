---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { Locale } from '../../i18n';

export async function getStaticPaths() {
  const publications = await getCollection('publication');
  return publications.map((publication) => ({
    params: { slug: publication.id.replace(/\.md$/, '') },
    props: { publication },
  }));
}

const locale = (Astro.currentLocale || 'zh') as Locale;
const { publication } = Astro.props;
const { Content } = await render(publication);
---

<Layout title={`${publication.data.title} - Zongwei Liu`} locale={locale}>
  <article class="article-page">
    <header class="article-header">
      <h1>{publication.data.title}</h1>
      <p class="entry-meta">
        {publication.data.authors.map((author, i) => (
          <span class={author === publication.data.highlightedAuthor ? 'highlighted' : ''}>
            {author}{i < publication.data.authors.length - 1 ? ', ' : ''}
          </span>
        ))}
      </p>
      <p class="entry-excerpt">
        <em>{publication.data.journal}</em> ({publication.data.date.getFullYear()})
      </p>
      <div class="entry-links">
        <a href={publication.data.doi} target="_blank" rel="noopener">DOI</a>
      </div>
    </header>
    <section class="article-content">
      <h2>{locale === 'zh' ? '摘要' : 'Abstract'}</h2>
      <Content />
    </section>
  </article>
</Layout>

