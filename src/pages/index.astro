---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const recentPosts = (await getCollection('post', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const recentPublications = (await getCollection('publication'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const profile = {
  name: '刘宗炜',
  institution: '上海交通大学',
  institutionUrl: 'https://www.sjtu.edu.cn/',
  bio: `吾本蜀人，负笈申江。庚子入交大，倏忽六载。
忆昔初中信息课上，初触键盘荧屏，便知此生当与代码为伴。然人生多起伏，命运总难期。本科虽未契初愿，仍向嵌入式方向深耕；升学之际，未敢轻试跨考408之锋，遂择保研本校，转而钻研导航定位算法。
今对Agent开发颇感兴趣，志在智能体构建，此番或可返归初心。虽乍看似涉猎未深，然几经赛道更迭，方信电子信息一脉，底层逻辑本自相通。电信范畴之内，实无不可跨越之鸿沟。
行远自迩，笃行不怠。愿持此心，再赴新程。
  `,
  avatar: '/images/avatar.jpg',
  interests: ['AI Agent', 'Linux'],
  education: [
    { course: '电子信息', institution: '上海交通大学', year: '至今' },
    { course: '测控技术与仪器', institution: '上海交通大学', year: '2024' },
  ],
  skills: [
    { name: 'Python', percent: 80, icon: 'fab fa-python', category: 'Technical' },
    { name: 'Linux', percent: 70, icon: 'fab fa-linux', category: 'Technical' },
    { name: 'C/C++', percent: 60, icon: 'fab fa-c', category: 'Technical' },
    { name: '电影 & 电视剧', percent: 100, icon: 'fas fa-film', category: 'Hobbies' },
    { name: '历史', percent: 90, icon: 'fas fa-book', category: 'Hobbies' },
    { name: '游戏', percent: 70, icon: 'fas fa-gamepad', category: 'Hobbies' },
  ],
  experience: [
    {
      title: '电子信息硕士',
      company: '上海交通大学',
      companyUrl: 'https://www.sjtu.edu.cn/',
      location: '上海，中国',
      dateStart: '2024年9月',
      dateEnd: '至今',
      description: '攻读硕士学位',
    },
    {
      title: '测控技术与仪器学士',
      company: '上海交通大学',
      companyUrl: 'https://www.sjtu.edu.cn/',
      location: '上海，中国',
      dateStart: '2020年9月',
      dateEnd: '2024年6月',
      description: '获得学士学位',
    },
  ],
  work: [
    {
      title: 'AI研发实习',
      company: '华测导航',
      companyUrl: 'https://www.chcnav.com/',
      logo: '/media/icons/brands/huace.jpg',
      location: '上海，中国',
      dateStart: '2025年6月',
      dateEnd: '至今',
      description: '将 AI 与团队工作结合，开发提效工具',
    },
    {
      title: '应用开发实习',
      company: '软银机器人',
      companyUrl: 'https://www.softbankrobotics.com.cn/',
      logo: '/media/icons/brands/softbank-robotics.png',
      location: '上海，中国',
      dateStart: '2023年6月',
      dateEnd: '2023年8月',
      description: '开发Pepper机器人应用软件。',
    },
  ],
  social: [
    { icon: 'fas fa-envelope', link: 'mailto:zvictorliu@outlook.com', label: 'Email' },
    { icon: 'fab fa-github', link: 'https://github.com/zvictorliu', label: 'GitHub' },
    { icon: 'fas fa-microchip', link: 'https://zvictorliu.github.io/techBlog/', label: 'Tech Blog' },
  ],
};

const contact = {
  email: 'zvictorliu@outlook.com',
  address: '上海市闵行区东川路800号',
};
---

<Layout locale="zh">
  <section id="about" class="section about-section">
    <div class="container">
      <div class="about-grid">
        <div class="profile-card">
          <div class="avatar-wrapper">
            <img 
              src={profile.avatar} 
              alt={profile.name}
              class="avatar"
              onerror="this.src='https://www.gravatar.com/avatar/?d=mp&s=270'"
            />
          </div>
          <h2 class="profile-name">{profile.name}</h2>
          <h3 class="profile-title">{t.profile.title}</h3>
          <h3 class="profile-institution">
            <a href={profile.institutionUrl} target="_blank" rel="noopener">
              {profile.institution}
            </a>
          </h3>
          <div class="social-links">
            {profile.social.map((item) => (
              <a href={item.link} target="_blank" rel="noopener" aria-label={item.label}>
                <i class={item.icon}></i>
              </a>
            ))}
          </div>
        </div>

        <div class="bio-content">
          <h2 class="section-title">{t.about.biography}</h2>
          <p class="bio-text">{profile.bio}</p>

          <div class="info-grid">
            <div class="info-section">
              <h3 class="info-title">{t.about.interests}</h3>
              <ul class="interests-list">
                {profile.interests.map((interest) => (
                  <li>
                    <i class="fas fa-book-open"></i>
                    {interest}
                  </li>
                ))}
              </ul>
            </div>

            <div class="info-section">
              <h3 class="info-title">{t.about.education}</h3>
              <ul class="education-list">
                {profile.education.map((edu) => (
                  <li>
                    <i class="fas fa-graduation-cap"></i>
                    <div class="edu-details">
                      <p class="course">{edu.course}, {edu.year}</p>
                      <p class="institution">{edu.institution}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="section skills-section">
    <div class="container">
      <h2 class="section-title">{t.skills.title}</h2>
      <div class="skills-grid">
        {['Technical', 'Hobbies'].map((category) => (
          <div class="skill-category">
            <h3 class="skill-category-title">{category === 'Technical' ? t.skills.technical : t.skills.hobbies}</h3>
            {profile.skills
              .filter((skill) => skill.category === category)
              .map((skill) => (
                <div class="skill-item">
                  <div class="skill-header">
                    <i class={skill.icon}></i>
                    <span class="skill-name">{skill.name}</span>
                  </div>
                  <div class="skill-bar">
                    <div class="skill-progress" style={`width: ${skill.percent}%`}></div>
                  </div>
                </div>
              ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="education" class="section education-section">
    <div class="container">
      <h2 class="section-title">{t.education.title}</h2>
      <div class="experience-timeline">
        {profile.experience.map((exp, index) => (
          <div class="experience-item">
            <div class="timeline-marker">
              <span class={`marker-dot ${index === 0 ? 'current' : ''}`}></span>
              {index < profile.experience.length - 1 && <div class="timeline-line"></div>}
            </div>
            <div class="experience-card">
              <div class="card-header">
                <div class="company-logo">
                  <a href={exp.companyUrl} target="_blank" rel="noopener">
                    <img src="/media/icons/brands/sjtulogo.svg" alt={exp.company} width="56" height="56" />
                  </a>
                </div>
                <div class="card-title-group">
                  <h3 class="card-title">{exp.title}</h3>
                  <p class="card-company">
                    <a href={exp.companyUrl} target="_blank" rel="noopener">{exp.company}</a>
                  </p>
<p class="card-meta">
                    {exp.dateStart} - {exp.dateEnd}
                    <span class="divider"></span>
                    {exp.location}
                  </p>
                </div>
              </div>
              <p class="card-description">{exp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="experience" class="section experience-section">
    <div class="container">
      <h2 class="section-title">{t.experience.title}</h2>
      <div class="experience-timeline">
        {profile.work.map((exp, index) => (
          <div class="experience-item">
            <div class="timeline-marker">
              <span class={`marker-dot ${index === 0 ? 'current' : ''}`}></span>
              {index < profile.work.length - 1 && <div class="timeline-line"></div>}
            </div>
            <div class="experience-card">
              <div class="card-header">
                <div class="company-logo">
                  <a href={exp.companyUrl} target="_blank" rel="noopener">
                    <img src={exp.logo} alt={exp.company} width="56" height="56" />
                  </a>
                </div>
                <div class="card-title-group">
                  <h3 class="card-title">{exp.title}</h3>
                  <p class="card-company">
                    <a href={exp.companyUrl} target="_blank" rel="noopener">{exp.company}</a>
                  </p>
                  <p class="card-meta">
                    {exp.dateStart} - {exp.dateEnd}
                    <span class="divider"></span>
                    {exp.location}
                  </p>
                </div>
              </div>
              <p class="card-description">{exp.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="posts" class="section posts-section">
    <div class="container">
      <h2 class="section-title">{t.posts.title}</h2>
      <div class="posts-list">
        {recentPosts.map((post) => (
          <article class="post-item">
            <div class="post-content">
              <h3 class="post-title">
                <a href={`/post/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
              </h3>
              <div class="post-meta">
                <span class="post-date">{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                <span class="divider"></span>
                <span class="post-read-time">1 {t.posts.minRead}</span>
              </div>
              <p class="post-excerpt">{post.data.description}</p>
            </div>
            {post.data.image && (
              <div class="post-image">
                <a href={`/post/${post.id.replace(/\.md$/, '')}`}>
                  <img src={post.data.image} alt={post.data.title} loading="lazy" />
                </a>
              </div>
            )}
          </article>
        ))}
        <div class="see-all">
          <a href="/post/">
            {t.posts.seeAll}
            <i class="fas fa-angle-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="publications" class="section publications-section">
    <div class="container">
      <h2 class="section-title">{t.publications.title}</h2>
      <div class="publications-list">
        {recentPublications.map((pub) => (
          <div class="publication-item">
            <i class="far fa-file-alt pub-icon"></i>
            <div class="pub-content">
              <p class="pub-authors">
                {pub.data.authors.map((author, i) => (
                  <span class={author === pub.data.highlightedAuthor ? 'highlighted' : ''}>
                    {author}{i < pub.data.authors.length - 1 ? ', ' : ''}
                  </span>
                ))}
                ({pub.data.date.getFullYear()}).
              </p>
              <h3 class="pub-title">
                <a href={`/publication/${pub.id.replace(/\.md$/, '')}`}>{pub.data.title}</a>
              </h3>
              <p class="pub-journal">
                <em>{pub.data.journal}</em>
              </p>
              <div class="pub-links">
                <a href={pub.data.doi} target="_blank" rel="noopener" class="btn btn-sm">DOI</a>
                <a href={`/publication/${pub.id.replace(/\.md$/, '')}`} class="btn btn-sm">URL</a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="see-all">
        <a href="/publication/">
          {t.publications.seeAll}
          <i class="fas fa-angle-right"></i>
        </a>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="container">
      <h2 class="section-title">{t.contact.title}</h2>
      <div class="contact-grid">
        <div class="contact-info">
          <h3>{t.contact.getInTouch}</h3>
          <p class="contact-text">
            {t.contact.message}
          </p>
          <ul class="contact-list">
            <li>
              <i class="fas fa-envelope"></i>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
            <li>
              <i class="fas fa-map-marker-alt"></i>
              <span>{contact.address}</span>
            </li>
          </ul>
        </div>
        <div class="contact-form-wrapper">
          <form class="contact-form" action="#" method="POST">
            <div class="form-group">
              <label for="name">{t.contact.form.name}</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">{t.contact.form.email}</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="message">{t.contact.form.message}</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">{t.contact.form.send}</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    align-items: start;
  }

  .profile-card {
    text-align: center;
    background: var(--card-bg);
    padding: 2rem;
    border-radius: 8px;
  }

  .avatar-wrapper {
    margin-bottom: 1.5rem;
  }

  .avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--border-color);
  }

  .profile-name {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .profile-title {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .profile-institution {
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .profile-institution a {
    color: var(--accent-color);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-color);
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .social-links a:hover {
    background: var(--accent-color);
    color: white;
    transform: translateY(-2px);
  }

  .bio-content .section-title {
    text-align: left;
    margin-bottom: 1.5rem;
  }

  .bio-text {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    text-align: justify;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .info-title {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--text-secondary);
  }

  .interests-list,
  .education-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .interests-list li,
  .education-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .interests-list i {
    color: var(--accent-color);
    margin-top: 0.25rem;
  }

  .education-list i {
    color: var(--accent-color);
    margin-top: 0.25rem;
  }

  .edu-details .course {
    margin: 0;
    font-weight: 500;
  }

  .edu-details .institution {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
  }

  .skill-category-title {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .skill-item {
    margin-bottom: 1.25rem;
  }

  .skill-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .skill-header i {
    width: 20px;
    color: var(--accent-color);
  }

  .skill-name {
    font-weight: 500;
  }

  .skill-bar {
    height: 6px;
    background: var(--border-color);
    border-radius: 3px;
    overflow: hidden;
  }

  .skill-progress {
    height: 100%;
    background: var(--accent-color);
    border-radius: 3px;
    transition: width 0.5s ease;
  }

  .experience-timeline {
    max-width: 800px;
    margin: 0 auto;
  }

  .experience-item {
    display: flex;
    gap: 1.5rem;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.5rem;
  }

  .marker-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--accent-color);
    background: var(--bg-color);
  }

  .marker-dot.current {
    background: var(--accent-color);
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    background: var(--border-color);
    margin-top: 0.5rem;
  }

  .experience-card {
    flex: 1;
    background: var(--card-bg);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .card-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .company-logo img {
    border-radius: 8px;
  }

  .card-title {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
  }

  .card-company {
    margin: 0 0 0.25rem 0;
    color: var(--text-secondary);
  }

  .card-meta {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .divider {
    margin: 0 0.5rem;
    color: var(--border-color);
  }

  .card-description {
    margin: 0;
    color: var(--text-secondary);
  }

  .posts-list,
  .publications-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .post-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .post-content {
    flex: 1;
  }

  .post-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
  }

  .post-meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .post-excerpt {
    margin: 0;
    color: var(--text-secondary);
  }

  .post-image {
    width: 150px;
    flex-shrink: 0;
  }

  .post-image img {
    width: 100%;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
  }

  .publication-item {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .pub-icon {
    font-size: 1.5rem;
    color: var(--accent-color);
    flex-shrink: 0;
  }

  .pub-authors {
    margin: 0 0 0.5rem 0;
    font-size: 0.95rem;
  }

  .pub-authors .highlighted {
    background: rgba(37, 99, 235, 0.15);
    padding: 0 2px;
    border-radius: 2px;
  }

  .pub-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
  }

  .pub-journal {
    margin: 0 0 1rem 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .pub-links {
    display: flex;
    gap: 0.5rem;
  }

  .see-all {
    text-align: center;
    margin-top: 2rem;
  }

  .see-all a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-info h3 {
    margin-bottom: 1rem;
  }

  .contact-text {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .contact-list i {
    width: 24px;
    color: var(--accent-color);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 500;
    font-size: 0.9rem;
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    background: var(--bg-color);
    color: var(--text-color);
    font-family: inherit;
    font-size: 1rem;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-color);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--accent-color);
    border-radius: 4px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    background: transparent;
    color: var(--accent-color);
  }

  .btn:hover {
    background: var(--accent-color);
    color: white;
