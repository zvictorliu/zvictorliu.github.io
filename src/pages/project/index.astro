---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n';

const locale = (Astro.currentLocale || 'zh') as Locale;
const t = useTranslations(locale);
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const presentLabel = locale === 'zh' ? '至今' : 'Present';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.endDate?.valueOf() ?? 0) - (a.data.endDate?.valueOf() ?? 0));

const formatDateRange = (project: (typeof projects)[number]) => {
  const start = project.data.startDate ?? project.data.date;
  const end = project.data.endDate ?? project.data.date;
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short' };
  if (start && project.data.ongoing) {
    return `${start.toLocaleDateString(dateLocale, options)} – ${presentLabel}`;
  }
  if (start && end) {
    return `${start.toLocaleDateString(dateLocale, options)} – ${end.toLocaleDateString(dateLocale, options)}`;
  }
  if (start) return start.toLocaleDateString(dateLocale, options);
  if (end) return end.toLocaleDateString(dateLocale, options);
  return locale === 'zh' ? '日期待定' : 'Date TBD';
};

const titleOf = (project: (typeof projects)[number]) =>
  locale === 'en' && project.data.titleEn ? project.data.titleEn : project.data.title;

const summaryOf = (project: (typeof projects)[number]) =>
  locale === 'en' && project.data.summaryEn ? project.data.summaryEn : project.data.summary;
---

<Layout title={`${t.work.title} - ${t.brand}`} locale={locale}>
  <section class="page-block">
    <div class="container">
      <header class="page-header">
        <h1>{t.work.title}</h1>
        <p class="page-subtitle">{locale === 'zh' ? '选过的工程与实验' : 'Selected projects and experiments'}</p>
      </header>

      {projects.map((project) => (
        <article class="entry">
          <p class="entry-meta">{formatDateRange(project)}</p>
          {project.data.tags && project.data.tags.length > 0 && (
            <div class="tag-row">
              {project.data.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
          <h2 class="entry-title">
            <a href={getRelativeLocaleUrl(locale, `/project/${project.id.replace(/\.md$/, '')}`)}>
              {titleOf(project)}
            </a>
          </h2>
          {summaryOf(project) && <p class="entry-excerpt">{summaryOf(project)}</p>}
          <div class="entry-links">
            <a href={getRelativeLocaleUrl(locale, `/project/${project.id.replace(/\.md$/, '')}`)}>{t.work.details}</a>
            {project.data.repo && (
              <a href={project.data.repo} target="_blank" rel="noopener">Repo</a>
            )}
            {project.data.demo && (
              <a href={project.data.demo} target="_blank" rel="noopener">Demo</a>
            )}
          </div>
        </article>
      ))}

      {projects.length === 0 && (
        <p class="empty-state">{locale === 'zh' ? '还没有项目。' : 'No projects yet.'}</p>
      )}
    </div>
  </section>
</Layout>
