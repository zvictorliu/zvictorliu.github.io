---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n';

const locale = (Astro.currentLocale || 'zh') as Locale;
const t = useTranslations(locale);

const publications = (await getCollection('publication'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={`${t.publications.title} - ${t.brand}`} locale={locale}>
  <section class="page-block">
    <div class="container">
      <header class="page-header">
        <h1>{t.publications.title}</h1>
        <p class="page-subtitle">{locale === 'zh' ? '论文与文稿' : 'Papers and manuscripts'}</p>
      </header>

      {publications.map((pub) => (
        <article class="entry">
          <p class="entry-meta">
            {pub.data.authors.map((author, i) => (
              <span class={author === pub.data.highlightedAuthor ? 'highlighted' : ''}>
                {author}{i < pub.data.authors.length - 1 ? ', ' : ''}
              </span>
            ))}
            ({pub.data.date.getFullYear()})
          </p>
          <h2 class="entry-title">
            <a href={getRelativeLocaleUrl(locale, `/publication/${pub.id.replace(/\.md$/, '')}`)}>
              {pub.data.title}
            </a>
          </h2>
          <p class="entry-excerpt"><em>{pub.data.journal}</em></p>
          {pub.data.summary && <p class="entry-excerpt">{pub.data.summary}</p>}
          <div class="entry-links">
            <a href={pub.data.doi} target="_blank" rel="noopener">DOI</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

