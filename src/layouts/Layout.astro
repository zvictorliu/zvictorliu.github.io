---
import Navbar from '../components/Navbar.astro';
import { contactEmail } from '../data/home';

interface Props {
  title?: string;
  locale?: string;
}

const { title = 'Zongwei Liu', locale } = Astro.props;
const lang = locale || Astro.currentLocale || 'en';
---

<!doctype html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={lang === 'zh' ? '刘宗炜 · 上海交通大学 · Agent 工程' : 'Zongwei Liu · Shanghai Jiao Tong University · Agent engineering'} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+SC:wght@400;500&family=Noto+Serif+SC:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main class="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-row">
        <p class="copyright">&copy; {new Date().getFullYear()} Zongwei Liu</p>
        <p class="footer-email">
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #f6f3ee;
    --text-color: #1c1917;
    --text-secondary: #57534e;
    --accent-color: #8f2d3a;
    --border-color: #e4ddd3;
    --card-bg: transparent;
    --header-height: 64px;
    --page-width: 880px;
    --font-display: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif;
    --font-body: Inter, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg-color: #141311;
      --text-color: #ece8e1;
      --text-secondary: #a8a29a;
      --accent-color: #d4545e;
      --border-color: #3a3632;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-height);
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-color);
    background-color: var(--bg-color);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .main-content {
    padding-top: var(--header-height);
    min-height: calc(100vh - 120px);
  }

  .container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.35;
    margin-top: 0;
    letter-spacing: 0.01em;
  }

  a {
    color: var(--text-color);
    text-decoration: none;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  a:hover {
    color: var(--accent-color);
    text-decoration: underline;
    text-decoration-color: var(--accent-color);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .site-footer {
    padding: 3rem 0 2.5rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .copyright,
  .footer-email {
    margin: 0;
  }

  .footer-email a {
    color: var(--text-secondary);
  }

  .section {
    padding: 3.5rem 0;
  }

  .section-title {
    font-size: 1.35rem;
    margin-bottom: 1.75rem;
    text-align: left;
  }

  .section-subheading {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .page-block {
    padding: 3.5rem 0 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    margin-bottom: 0.4rem;
  }

  .page-subtitle {
    margin: 0;
    color: var(--text-secondary);
  }

  .entry {
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .entry-title {
    margin: 0 0 0.35rem;
    font-size: 1.12rem;
  }

  .entry-meta {
    margin: 0 0 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .entry-excerpt {
    margin: 0 0 0.65rem;
    color: var(--text-secondary);
  }

  .entry-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }

  .entry-links a {
    color: var(--text-secondary);
  }

  .highlighted {
    color: var(--text-color);
    font-weight: 600;
  }

  .meta-sep {
    margin: 0 0.4rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
  }

  .tag {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .article-page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 3.5rem 1.5rem 5rem;
  }

  .article-header {
    margin-bottom: 1.8rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .article-content {
    line-height: 1.85;
  }

  .article-content h2 {
    margin-top: 2rem;
    margin-bottom: 0.85rem;
  }

  .article-content h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.7rem;
  }

  .article-content p {
    margin-bottom: 1.2rem;
  }

  .article-content img {
    border-radius: 2px;
    border: 1px solid var(--border-color);
    margin: 1.25rem 0;
  }

  .empty-state {
    color: var(--text-secondary);
    padding: 2rem 0;
  }

  @media (max-width: 768px) {
    .section {
      padding: 2.75rem 0;
    }

    .section-title {
      font-size: 1.2rem;
    }

    .page-header h1 {
      font-size: 1.7rem;
    }

    .article-page {
      padding: 2.75rem 1.5rem 4rem;
    }
  }
</style>
