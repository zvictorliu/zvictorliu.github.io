---
interface Props {
  hint: string;
}

const { hint } = Astro.props;
---

<div class="room-stage">
  <canvas id="room-canvas"></canvas>
  <p class="room-hint">{hint}</p>
</div>

<script>
  import { initRoom } from '../lib/room';

  const canvas = document.getElementById('room-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    const dispose = initRoom(canvas);
    window.addEventListener('pagehide', dispose, { once: true });
  }
</script>

<style>
  .room-stage {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--header-height));
    overflow: hidden;
    background: #1a1612;
  }

  #room-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .room-hint {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    margin: 0;
    transform: translateX(-50%);
    color: rgba(236, 232, 225, 0.72);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    pointer-events: none;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
    white-space: nowrap;
  }
</style>
